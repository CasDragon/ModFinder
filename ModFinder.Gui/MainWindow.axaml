<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mod="clr-namespace:ModFinder.Mod;assembly=ModFinder.Core"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="ModFinder.Gui.MainWindow"
        x:DataType="Window"
        Title="ModFinder - Warhammer 40,000: Rogue Trader (Linux)"
        Width="1120" Height="720"
        MinWidth="900" MinHeight="600"
        Background="#18181b">

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#111113" BorderBrush="#27272a" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="⚔️" FontSize="22" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="ModFinder: Rogue Trader" FontSize="18" FontWeight="SemiBold" Foreground="#f4f4f5"/>
                        <TextBlock Text="Linux Native Mod Manager (Proton Prefix Integration)" FontSize="12" Foreground="#a1a1aa"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Name="RefreshButton" Content="🔄 Refresh All" Background="#27272a" Foreground="#f4f4f5" Padding="12,6" CornerRadius="4"/>
                    <Button Name="InstallZipButton" Content="📦 Install Zip..." Background="#27272a" Foreground="#f4f4f5" Padding="12,6" CornerRadius="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search and Filters Bar -->
        <Border Grid.Row="1" Background="#1f1f23" BorderBrush="#27272a" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <RadioButton Name="AllModsRadio" Content="All Mods" IsChecked="True" GroupName="ViewFilter"/>
                    <RadioButton Name="InstalledRadio" Content="Installed Only" GroupName="ViewFilter"/>
                </StackPanel>

                <TextBox Grid.Column="1" Name="SearchBox" Margin="24,0,16,0" Watermark="Search mods by name, author, or id..." VerticalAlignment="Center" Height="32"/>

                <TextBlock Grid.Column="2" Name="ModCountText" Text="Loading mods..." VerticalAlignment="Center" Foreground="#a1a1aa" Margin="0,0,16,0"/>
            </Grid>
        </Border>

        <!-- Main Content Area: Split List and Details -->
        <Grid Grid.Row="2" ColumnDefinitions="*, 380">
            <!-- Mod DataGrid / List -->
            <ListBox Grid.Column="0" Name="ModsListBox" Background="Transparent" BorderThickness="0" Margin="6">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="mod:ModViewModel">
                        <Border Background="#212124" BorderBrush="#2d2d30" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                <!-- Status indicator -->
                                <TextBlock Grid.Column="0" Text="●" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Foreground="{Binding IsInstalled, Converter={x:Null}}"/>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#f4f4f5"/>
                                        <TextBlock Text="{Binding Type, StringFormat='[{0}]'}" Foreground="#71717a" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding About}" Foreground="#a1a1aa" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="450"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding Author, StringFormat='Author: {0}'}" Foreground="#71717a" FontSize="11"/>
                                        <TextBlock Text="{Binding StatusText}" Foreground="#38bdf8" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Toggle Enabled (if installed) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0" VerticalAlignment="Center">
                                    <CheckBox Content="Active" IsChecked="{Binding Enabled}" IsVisible="{Binding IsInstalled}"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="{Binding ButtonText}" Tag="{Binding}" Name="ActionButton"
                                            Background="#2563eb" Foreground="White" Padding="10,5" CornerRadius="4"/>
                                    <Button Content="Uninstall" Tag="{Binding}" Name="UninstallButton"
                                            Background="#dc2626" Foreground="White" Padding="8,5" CornerRadius="4"
                                            IsVisible="{Binding CanUninstall}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Details Panel -->
            <Border Grid.Column="1" Background="#141416" BorderBrush="#27272a" BorderThickness="1,0,0,0" Padding="16">
                <ScrollViewer>
                    <StackPanel Name="DetailsPanel" Spacing="10">
                        <TextBlock Name="DetailsTitle" Text="Select a mod" FontSize="18" FontWeight="Bold" Foreground="#f4f4f5"/>
                        <TextBlock Name="DetailsAuthor" Text="" Foreground="#a1a1aa" FontSize="12"/>
                        <TextBlock Name="DetailsStatus" Text="" Foreground="#38bdf8" FontSize="12"/>

                        <Separator Background="#27272a" Margin="0,4"/>

                        <TextBlock Text="Description:" FontWeight="SemiBold" Foreground="#e4e4e7"/>
                        <TextBlock Name="DetailsDescription" Text="" TextWrapping="Wrap" Foreground="#d4d4d8" FontSize="13" LineHeight="18"/>

                        <Separator Background="#27272a" Margin="0,4"/>

                        <TextBlock Text="Source &amp; Version:" FontWeight="SemiBold" Foreground="#e4e4e7"/>
                        <TextBlock Name="DetailsSource" Text="" Foreground="#a1a1aa" FontSize="12"/>
                        <TextBlock Name="DetailsVersion" Text="" Foreground="#a1a1aa" FontSize="12"/>

                        <Button Name="OpenHomepageButton" Content="🌐 Open Homepage" Background="#27272a" Foreground="#f4f4f5" Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer / Path Status Bar -->
        <Border Grid.Row="3" Background="#111113" BorderBrush="#27272a" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Name="StatusGameDir" Text="Game: ..." Foreground="#71717a" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Name="StatusPrefixDir" Text="Prefix: ..." Foreground="#71717a" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Linux Native Port" Foreground="#52525b" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
